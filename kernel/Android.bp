bootstrap_go_package {
    name: "soong-kleaf-kernel",
    pkgPath: "kleaf/soong/kernel",
    deps: [
        "blueprint",
        "blueprint-proptools",
        "soong",
        "soong-android",
    ],
    srcs: ["kernel.go"],
    pluginFor: ["soong_build"],
}

blueprint_go_binary {
    name: "kernel_source_deps",
    srcs: ["source_deps/main.go"],
}
