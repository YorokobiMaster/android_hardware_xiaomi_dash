package {
    default_applicable_licenses: ["mtk-esim-proprietary"],
}

license {
    name: "mtk-esim-proprietary",
    visibility: [":__subpackages__"],
    license_kinds: ["legacy_proprietary"],
}

cc_prebuilt_binary {
    name: "dash-esim-modem",
    srcs: ["bin/mtkmtb"],
    system_ext_specific: true,
    compile_multilib: "64",
    strip: { none: true },
    shared_libs: [
        "libmipc_dash_esim", "libmtkrillog_dash_esim", "libutils", "libcutils", "libc++",
    ],
}

cc_prebuilt_library_shared {
    name: "libmipc_dash_esim",
    stem: "libmipc",
    srcs: ["lib64/libmipc.so"],
    system_ext_specific: true,
    relative_install_path: "dash-esim",
    compile_multilib: "64",
    strip: { none: true },
    shared_libs: ["libmtkrillog_dash_esim", "libtrm_dash_esim", "libmtkproperty_dash_esim", "libc++"],
}

cc_prebuilt_library_shared {
    name: "libtrm_dash_esim",
    stem: "libtrm",
    srcs: ["lib64/libtrm.so"],
    system_ext_specific: true,
    relative_install_path: "dash-esim",
    compile_multilib: "64",
    strip: { none: true },
    shared_libs: ["libmtkrillog_dash_esim", "libmtkproperty_dash_esim", "libc++"],
}

cc_prebuilt_library_shared {
    name: "libmtkrillog_dash_esim",
    stem: "libmtkrillog",
    srcs: ["lib64/libmtkrillog.so"],
    system_ext_specific: true,
    relative_install_path: "dash-esim",
    compile_multilib: "64",
    strip: { none: true },
    shared_libs: ["liblog", "libc++"],
}
