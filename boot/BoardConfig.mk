DASH_HARDWARE_PATH ?= hardware/xiaomi/dash
DASH_KERNEL_INPUTS := vendor/xiaomi/dash/kernel-inputs
DASH_AVB_INPUTS := vendor/xiaomi/dash/avb

BOARD_USES_GENERIC_KERNEL_IMAGE := true
# Includes ACK ASB-2026-10-05_15-6.6.
BOOT_SECURITY_PATCH := 2026-10-01
INIT_BOOT_SECURITY_PATCH := $(PLATFORM_SECURITY_PATCH)

BOARD_BOOT_HEADER_VERSION := 4
BOARD_INIT_BOOT_HEADER_VERSION := 4
BOARD_BOOTIMAGE_PARTITION_SIZE := 67108864
BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE := 67108864
BOARD_INIT_BOOT_IMAGE_PARTITION_SIZE := 8388608
BOARD_KERNEL_PAGESIZE := 4096
BOARD_FLASH_BLOCK_SIZE := 262144
BOARD_KERNEL_BASE := 0x00000000
BOARD_KERNEL_CMDLINE := bootopt=64S3,32N2,64N2
BOARD_RAMDISK_USE_LZ4 := true

# Stock OS4.0.4.0.XPLCNXM platform.dtb.
BOARD_INCLUDE_DTB_IN_BOOTIMG := true
BOARD_PREBUILT_DTBIMAGE_DIR := $(DASH_KERNEL_INPUTS)
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOT_HEADER_VERSION) --kernel_offset 0x80000000
BOARD_MKBOOTIMG_ARGS += --ramdisk_offset 0xa6f00000 --tags_offset 0x87c80000
BOARD_MKBOOTIMG_ARGS += --dtb_offset 0x87c80000
BOARD_MKBOOTIMG_INIT_ARGS += --header_version $(BOARD_INIT_BOOT_HEADER_VERSION)

# YARP (2026-11-18) is packaged as a legacy LZ4 fragment.
TARGET_NO_RECOVERY := true
BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT := true
BOARD_INCLUDE_RECOVERY_RAMDISK_IN_VENDOR_BOOT := true
RECOVERY_RAMDISK_SOURCE ?= $(DASH_HARDWARE_PATH)/recovery/ramdisk.cpio.lz4
BOARD_VENDOR_RAMDISK_FRAGMENT.recovery.PREBUILT := $(RECOVERY_RAMDISK_SOURCE)
TARGET_FS_CONFIG_GEN += $(DASH_HARDWARE_PATH)/boot/config.fs

BOARD_USES_VENDOR_DLKMIMAGE := true
BOARD_USES_SYSTEM_DLKMIMAGE := true
BOARD_VENDOR_DLKMIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_VENDOR_DLKMIMAGE_PARTITION_SIZE := 25477120
BOARD_VENDOR_DLKMIMAGE_EROFS_COMPRESSOR := lz4hc,level=12
BOARD_VENDOR_DLKMIMAGE_EROFS_PCLUSTER_SIZE := 16384
BOARD_SYSTEM_DLKMIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_SYSTEM_DLKMIMAGE_PARTITION_SIZE := 7323648
BOARD_SYSTEM_DLKMIMAGE_EROFS_COMPRESSOR := lz4hc,level=12
BOARD_SYSTEM_DLKMIMAGE_EROFS_PCLUSTER_SIZE := 16384

# The ROM selects its AVB signer. Retain the OS4 vendor descriptor.
BOARD_AVB_ENABLE := true
BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --set_hashtree_disabled_flag
# LK checks the region property even when image authentication is bypassed.
BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --prop com.android.build.init_boot.sku:NATIVE
BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --include_descriptors_from_image $(DASH_AVB_INPUTS)/vbmeta_vendor.img
